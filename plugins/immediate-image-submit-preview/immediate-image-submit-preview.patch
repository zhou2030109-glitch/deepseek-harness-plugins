+ * thread for a large file; `readAsDataURL` encodes natively (off the JS main
+ * thread) and returns a `data:` URL whose base64 payload we strip. The payload
+ * is byte-for-byte the file's content, so it is identical to what
+ * `bytesToBase64(await file.arrayBuffer())` produced.
+ */
+function readAsBase64(file: File): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader()
+    reader.onload = () => {
+      const result = reader.result
+      if (typeof result !== 'string') {
+        reject(new Error('readAsBase64: FileReader did not produce a data URL'))
+        return
+      }
+      const comma = result.indexOf(',')
+      resolve(comma === -1 ? '' : result.slice(comma + 1))
+    }
+    reader.onerror = () => {
+      reject(reader.error ?? new Error('readAsBase64: failed to read image file'))
+    }
+    reader.readAsDataURL(file)
+  })
+}
+
 function revokePreview(url: string): void {
   if (url.startsWith('blob:')) URL.revokeObjectURL(url)
 }
+
+/**
+ * Content hash matching the host's `sha256:<hex>` attachment id, or null when
+ * the WebCrypto digest API is unavailable (the caller then falls back to the
+ * normal readAttachment re-fetch path).
+ */
+async function fileSha256(file: File): Promise<string | null> {
+  const subtle = (globalThis as { crypto?: Crypto }).crypto?.subtle
+  if (subtle === undefined) return null
+  try {
+    const digest = await subtle.digest('SHA-256', await file.arrayBuffer())
+    return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('')
+  } catch {
+    return null
+  }
+}
